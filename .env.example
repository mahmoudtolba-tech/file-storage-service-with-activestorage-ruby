# Rails environment
RAILS_ENV=development

# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=file_storage_service_dev

# Redis configuration
REDIS_URL=redis://redis:6379/1

# Active Storage
ACTIVE_STORAGE_SERVICE=local

# AWS (optional, for S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=